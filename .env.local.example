# Vercel AI Gateway — used by app/api/chat/route.ts to power the live
# chat panel in the "Technical Fluency" section (anthropic/claude-sonnet-5).
# Get a key at https://vercel.com/ai-gateway, then copy this file to
# .env.local and fill it in.
AI_GATEWAY_API_KEY=

# Optional fallback: if AI_GATEWAY_API_KEY is not set, the app will fall
# back to a direct OpenAI key (gpt-5.1) instead. Only one of the two is
# required.
OPENAI_API_KEY=
