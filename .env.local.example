# Vercel AI Gateway powers the live chat panel in the "Technical Fluency"
# section (app/api/chat/route.ts, anthropic/claude-sonnet-5).
#
# Recommended: OIDC (no key needed here at all)
#   vercel link
#   vercel env pull .env.local
# This writes a VERCEL_OIDC_TOKEN below automatically, which
# @ai-sdk/gateway uses to auth — nothing to fill in manually.
#
# Alternative: a static AI Gateway key (useful for CI or non-Vercel envs)
AI_GATEWAY_API_KEY=

# Optional fallback: if neither of the above is set, the app falls back to
# a direct OpenAI key (gpt-5.1) instead.
OPENAI_API_KEY=

# Vercel Edge Config connection string for the chat's grounding facts
# (lib/rag.ts). Optional locally — without it, the app falls back to the
# static copy in lib/content/knowledge-chunks.ts. `vercel env pull` fills
# this in automatically once the project is linked.
EDGE_CONFIG=

# Set by Vercel automatically for the /api/cron/verify-target-accounts
# route to authenticate that the request actually came from Vercel Cron.
# `vercel env pull` fills this in once configured on the project.
CRON_SECRET=
